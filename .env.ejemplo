# Copiar como .env (NUNCA subir .env al repo) y completar.
# Este archivo es la plantilla: no poner acá valores reales.

# Cadena de conexión de MongoDB Atlas (Database → Connect → Drivers).
# Usar un usuario de base con permiso solo sobre la base del panel.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_BASE=panel_it

# Clave para cifrar las contraseñas de los equipos. Generarla con:
#   npm run generar-clave
# Guardar una copia en el gestor de contraseñas: si se pierde, las
# contraseñas guardadas en el panel NO se pueden recuperar.
CLAVE_CIFRADO=

# Imágenes de las páginas (cuenta de Cloudinary → Dashboard → API Keys).
# Opcional: sin esto todo funciona menos subir imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=panel-it

PUERTO=3080
# "production" en el servidor (cookie solo por HTTPS); "development" para probar en la PC
NODE_ENV=production
HORAS_SESION=12
